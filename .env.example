# 管理员账号（格式：用户名:密码,用户名2:密码2；部署到公网必须配置；留空则鉴权关闭，人人都是管理员）
ADMIN_USERS=admin:test123

# 硅基流动 https://siliconflow.cn 注册获取（免费），用于小说 RAG 的 embedding
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# 智谱开放平台 https://open.bigmodel.cn 注册后创建 API Key 填在这里
# 模型路由：快模型默认，深度模型开"深度思考"时用（两者都免费）
MODEL_FAST=glm-4-flash
MODEL_DEEP=glm-z1-flash
# GLM-4-Flash 永久免费，新用户另送 2000 万 tokens
# ⚠️ 此处只放占位符——真实 key 只写本地 .env（已被 gitignore），切勿提交到任何公开文件
ZHIPU_API_KEY=

# 日志：级别 error/warn/info/debug（默认 info）；LOG_PRETTY=false 强制 JSON 输出（生产容器部署用）
LOG_LEVEL=info
LOG_PRETTY=
