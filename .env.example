# 访问密码（部署到公网时必须设置；留空则不启用鉴权，适合本地开发）
ACCESS_PASSWORD=

# 硅基流动 https://siliconflow.cn 注册获取（免费），用于小说 RAG 的 embedding
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# 智谱开放平台 https://open.bigmodel.cn 注册后创建 API Key 填在这里
# 模型路由：快模型默认，深度模型开"深度思考"时用（两者都免费）
MODEL_FAST=glm-4-flash
MODEL_DEEP=glm-z1-flash
# GLM-4-Flash 永久免费，新用户另送 2000 万 tokens
ZHIPU_API_KEY=a2127a6f81164da5b3b587d9cc3dcd72.61ufMip7kR0mIaOh
